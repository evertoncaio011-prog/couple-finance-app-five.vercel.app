NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# URL pública do app, usada nos redirects de sucesso/cancelamento do
# Stripe Checkout e do Billing Portal. Em produção, use o domínio real
# (ex.: https://couple-finance-app-five.vercel.app). Em dev, pode deixar
# em branco — o app deduz a partir da própria requisição.
NEXT_PUBLIC_APP_URL=

# Painel /admin: e-mails com acesso, separados por vírgula. Só quem
# estiver aqui consegue abrir /admin — qualquer outra pessoa é
# redirecionada de volta pro /dashboard.
ADMIN_EMAILS=voce@example.com

# Chave service_role do Supabase (Project Settings > API > service_role).
# NUNCA prefixe com NEXT_PUBLIC_, NUNCA comite: ela ignora todo o RLS.
# Usada só no webhook do Stripe e no painel /admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (dashboard.stripe.com > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_your-secret-key
# ID do preço da assinatura (Product > Pricing > copiar o "API ID" do price)
STRIPE_PRICE_ID=price_your-price-id
# Gerado ao criar o endpoint de webhook em Developers > Webhooks, ou pelo
# Stripe CLI (`stripe listen`) durante o desenvolvimento local.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
